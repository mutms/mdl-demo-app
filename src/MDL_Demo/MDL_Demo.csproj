<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mdl-demo</AssemblyName>
    <RootNamespace>MDL_Demo</RootNamespace>
    <Product>MDL Demo</Product>
    <AssemblyTitle>MDL Demo</AssemblyTitle>
    <Description>Run throwaway Moodle/MuTMS demo sites on Windows, in a container.</Description>
    <Version>1.1.0</Version>
    <Copyright>Copyright (c) 2026 Petr Skoda</Copyright>
    <!-- Made by make-icon.ps1 from mdl-demo's favicon.svg. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
