<UserControl x:Class="MDL_Demo.CreateForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,6" />
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="NameError" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Optional. Shown at the top of the demo and used as the Moodle site name." />

        <CheckBox x:Name="DownloadBox" Content="_Download the latest version first" IsChecked="True" />
        <TextBlock x:Name="DownloadHint" Margin="28,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Recommended. Uncheck to use the version already on this computer." />

        <CheckBox x:Name="OpenBox" Content="_Open in the browser when it is ready" IsChecked="True" />
    </StackPanel>
</UserControl>
