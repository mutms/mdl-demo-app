<?xml version="1.0" encoding="utf-8"?>
<!-- One MDL_Demo.exe that runs on any 64-bit Windows, no .NET install needed:
       dotnet publish win\MDL_Demo -p:PublishProfile=win-x64
     Output: dist\MDL_Demo.exe and dist\MDL_Demo_Unsigned.zip (the exe zipped, for
     downloads; "Unsigned" until releases are code-signed). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs go inside the exe too, so it really is one file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <DistDir>$(MSBuildProjectDirectory)\..\..\dist\</DistDir>
  </PropertyGroup>

  <Target Name="Dist" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(DistDir)$(AssemblyName)_Unsigned.zip" Overwrite="true" />
    <Message Importance="high" Text="MDL_Demo -> $([System.IO.Path]::GetFullPath('$(DistDir)'))" />
  </Target>
</Project>
